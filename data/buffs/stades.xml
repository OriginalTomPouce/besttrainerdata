<buff>
	<name>Tourb'Siphon</name>
	<category>Neutral</category>
	
	<animation category="0" mode="0" force="5">MAIN_big_tornado</animation>
	
	<trigger when="MOVE_DECLARE" actor="source">
		<StringCompare name="v:type_move" value="Feu">
			<SetVariable name="v:move_hit" value="0"/>
			<SetVariable name="v:move_success" value="0">Le Tourbillon a annulé l'attaque !</SetVariable>
		</StringCompare>
	</trigger>
	<trigger when="END_TURN" actor="source">
		<NumberCompare name="v:self:duration" comparator="sup" value="1">
			<SetVariable name="v:val_1" value="v:source:max_hp">
				<DivideVariable name="v:val_1" value="8"/>
				<NumberCompare name="v:val_1" comparator="equal" value="0">
					<SetVariable name="v:val_1" value="1"/>
				</NumberCompare>
				<Damage target="source" value="v:val_1" reason="Statut">[SOURCE] est blessé par le tourbillon.</Damage>
			</SetVariable>
		</NumberCompare>
	</trigger>
	<trigger when="CHECK_CHANGE_ORDER" actor="source">
			<SetVariable name="v:result" value="0"/>
	</trigger>
</buff>
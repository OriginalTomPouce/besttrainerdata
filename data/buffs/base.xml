			<AdditionVariable name="v:val_1" value="2"/>
			<SetVariable name="v:self:value" value="v:val_1"/>
		</NumberCompare>
		
	</trigger>
	
	<trigger when="BEFORE_MOVE" actor="source" priority="-5">
		<NumberCompare name="v:can_move" comparator="sup" value="0">
			<SubstractVariable  name="v:self:value" value="1"/>
			<NumberCompare   name="v:self:value" comparator="equal" value="0">
				<RemoveBuff target="source" name="Confusion">
					<DisplayMessage>[SOURCE] n'est plus confus !</DisplayMessage>
					<EndEffect/>
				</RemoveBuff>
			</NumberCompare>
			<SelfAnim>[SOURCE] est confus !</SelfAnim>
			<SubEffect chance="33">

<buff>
	<name>Confusion</name>
	<category>Negative</category>
	<IA_value>-35</IA_value>
	
	
	
	<trigger when="BEFORE_ADD">
		<NumberCompare name="v:self:value" comparator="equal" value="0">
			<SetVariable name="v:val_1" value="v:d8"/>
			<SubstractVariable  name="v:val_1" value="1"/>

<?xml version="1.0" encoding="UTF-8"?>
<buff>
	<name>Brûlure</name>
	<primary>BRU</primary>
	
	<animation category="0" mode="2">MAIN_flame</animation>
	<passive_anim category="0" mode="2">TINY_flame</passive_anim>
	<category>Negative</category>
	
	<IA_value>-30</IA_value>
	
	<trigger when="BEFORE_ADD">
		<StringCompare name="v:source:type" comparator="has" value="Feu">
			<Cancel/>
		</StringCompare>
	</trigger>
	<trigger when="MOVE_DECLARE" actor="source">
		<NumberCompare name="v:move_cat" comparator="equal" value="1">
			<MultiplyVariable name="v:mult_dmg" value="0.5"/>
		</NumberCompare>
	</trigger>
	<trigger when="END_TURN" actor="source">
		<SetVariable name="v:val_1" value="v:source:max_hp">
			<DivideVariable name="v:val_1" value="16"/>
			<NumberCompare name="v:val_1" comparator="equal" value="0">
				<SetVariable name="v:val_1" value="1"/>
			</NumberCompare>
			<Damage target="source" value="v:val_1" reason="Statut">
				<SelfAnim>[SOURCE] souffre de sa brûlure.</SelfAnim>
			</Damage>
		</SetVariable>
	</trigger>
</buff>


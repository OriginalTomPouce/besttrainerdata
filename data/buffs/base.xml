<buff>
	<name>Pics Toxiques</name>
	
	<category>Negative</category>
	<tag>Hazards</tag>
	<tag>Spinnable</tag>
	<teambuff/>
	
	<trigger when="BUFF_VALUE">
		<SetValue name="v:result" value="v:opponent:n_creature"/>
		<SubstractVariable name="v:result" value="1"/>
		<MultiplyVariable name="v:result" value="15"/>
	</trigger>
	<trigger when="ON_CALL" actor="source">
		<StringCompare name="v:source:type" comparator="has" value="Poison">
			<RemoveBuff target="source" name="Pics Toxiques">[SOURCE] enlève les Pics Toxics !</RemoveBuff>
			<EndEffect/>
		</StringCompare>
		<ImmunityCheck target="source" value="Sol"/>
		<NumberCompare name="v:return_value" comparator="equal" value="0">
			<AddStatut target="source" name="Poison">[SOURCE] est empoisonné par les Pics Toxics !</AddStatut>
		</NumberCompare>
	</trigger>
</buff>


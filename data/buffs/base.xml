<buff>
	<name>Toile Gluante</name>
	<teambuff/>
	<category>Negative</category>
	<tag>Spinnable</tag>
	
	<trigger when="BUFF_VALUE">
		<SetValue name="v:result" value="v:opponent:n_creature"/>
		<SubstractVariable name="v:result" value="1"/>
		<MultiplyVariable name="v:result" value="20"/>
	</trigger>
	<trigger when="ON_CAMM" actor="source">
		<ImmunityCheck target="source" value="Sol"/>
		<NumberCompare name="v:return_value" comparator="equal" value="0">
			<ModifyStat target="source" value="-1" name="vit">La Vitesse de [SOURCE] a diminuée !</ModifyStat>
		</NumberCompare>
	</trigger>
</buff>


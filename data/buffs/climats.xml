<buff>
	<name>Champ Electrifié</name>
	<category>Positive</category>
	<spot>Terrain</spot>
	<IA_value>20</IA_value>
	
	<trigger when="CHECK_BEFORE_ADD_STATUT" actor="source">
		<ImmunityCheck target="source" value="Sol"/>
		<NumberCompare name="v:return_value" comparator="equal" value="0">
			<StringCompare name="v:newbuff:name" comparator="has" value="Sommeil">
				<Cancel/>
			</StringCompare>
		</NumberCompare>
	</trigger>
	<trigger when="MOVE_DECLARE" actor="source">
		<StringCompare name="v:type_move" comparator="has" value="Electrik">
			<MultiplyVariable name="v:mult_dmg" value="1.5"/>
		</StringCompare>
	</trigger>
</buff>

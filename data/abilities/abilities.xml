<?xml version="1.0" encoding="UTF-8"?>
<ability>
	<name>Samuraï</name>
	
	<trigger when="ON_CALL" actor="source">
		<buffStat to="source" name="crit" val="1"/>
	</trigger>
	<trigger when="MOVE_DECLARE" actor="source">
		<ConditionCompare name="MoveSubtype" comparator="equal" value="Edge">
			<MultiplyValue name="CoeffPower">1.5</MultiplyValue>
		</ConditionCompare>
	</trigger>
	<trigger when="AFTER_MOVE" actor="source">
		<ConditionCompare name="HitsDone" comparator="sup" value="0">
			<buffStat to="source" name="def" val="1"/>
		</ConditionCompare>
	</trigger>
</ability>

<ability>
	<name>Vampirique</name>
	
	<trigger when="AFTER_MOVE" actor="source">
		<SetVariable name="v:val_1" value="v:total_damage"/>
		<DivideVariable name="v:val_1" value="5" round="up"/>
		<Heal target="source" value="v:val_1">[SOURCE] regagne des points de vie grâce à Vampirisme.</Heal>
	</trigger>
</ability>

<ability>
	<name>Isograisse</name>
	
